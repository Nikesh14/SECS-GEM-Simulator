# ---------------------------------------------------------------------------
# .gitignore for the EquipmentSimulator (.NET) solution
# ---------------------------------------------------------------------------

## Build output
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
build/
bld/

## Visual Studio
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates
*.VC.db
*.VC.VC.opendb

## Rider / JetBrains
.idea/
_ReSharper*/
*.DotSettings.user

## VS Code (keep shared configs, ignore machine-local ones)
.vscode/*
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/extensions.json

## Test results / coverage
[Tt]est[Rr]esults/
[Cc]overage*/
*.trx
*.coverage
*.coveragexml

## NuGet
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/
.nuget/
project.lock.json

## Logs / temp
*.log
*.tmp
*.cache

## OS cruft
.DS_Store
Thumbs.db
desktop.ini

## Claude Code (keep shared project settings, ignore local overrides)
.claude/settings.local.json

# ---------------------------------------------------------------------------
# Project-specific
# ---------------------------------------------------------------------------

# Backup/snapshot archives should not live in the repo (e.g. EquipmentSimulator.zip ~20 MB)
*.zip

# Machine-local / secret config overrides — keep appsettings.json itself tracked
appsettings.*.local.json
**/secrets.json
